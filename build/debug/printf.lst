  24:external/printf/printf.c **** //
  25:external/printf/printf.c **** // \brief Tiny printf, sprintf and (v)snprintf implementation, optimized for speed on
  26:external/printf/printf.c **** //        embedded systems with a very limited resources. These routines are thread
  27:external/printf/printf.c **** //        safe and reentrant!
  28:external/printf/printf.c **** //        Use this instead of the bloated standard/newlib printf cause these use
  29:external/printf/printf.c **** //        malloc for printf (and may not be thread safe).
  30:external/printf/printf.c **** //
ARM GAS  C:\Users\bernd\AppData\Local\Temp\ccLnovA9.s 			page 2


