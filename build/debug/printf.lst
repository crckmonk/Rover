  44:external/printf/printf.c **** #endif
  45:external/printf/printf.c **** 
  46:external/printf/printf.c **** 
  47:external/printf/printf.c **** // 'ntoa' conversion buffer size, this must be big enough to hold one converted
  48:external/printf/printf.c **** // numeric number including padded zeros (dynamically created on stack)
  49:external/printf/printf.c **** // default: 32 byte
  50:external/printf/printf.c **** #ifndef PRINTF_NTOA_BUFFER_SIZE
  51:external/printf/printf.c **** #define PRINTF_NTOA_BUFFER_SIZE    32U
  52:external/printf/printf.c **** #endif
  53:external/printf/printf.c **** 
  54:external/printf/printf.c **** // 'ftoa' conversion buffer size, this must be big enough to hold one converted
  55:external/printf/printf.c **** // float number including padded zeros (dynamically created on stack)
  56:external/printf/printf.c **** // default: 32 byte
  57:external/printf/printf.c **** #ifndef PRINTF_FTOA_BUFFER_SIZE
  58:external/printf/printf.c **** #define PRINTF_FTOA_BUFFER_SIZE    32U
  59:external/printf/printf.c **** #endif
  60:external/printf/printf.c **** 
  61:external/printf/printf.c **** // support for the floating point type (%f)
  62:external/printf/printf.c **** // default: activated
  63:external/printf/printf.c **** #ifndef PRINTF_DISABLE_SUPPORT_FLOAT
  64:external/printf/printf.c **** #define PRINTF_SUPPORT_FLOAT
  65:external/printf/printf.c **** #endif
  66:external/printf/printf.c **** 
  67:external/printf/printf.c **** // support for exponential floating point notation (%e/%g)
  68:external/printf/printf.c **** // default: activated
  69:external/printf/printf.c **** #ifndef PRINTF_DISABLE_SUPPORT_EXPONENTIAL
  70:external/printf/printf.c **** #define PRINTF_SUPPORT_EXPONENTIAL
  71:external/printf/printf.c **** #endif
  72:external/printf/printf.c **** 
  73:external/printf/printf.c **** // define the default floating point precision
  74:external/printf/printf.c **** // default: 6 digits
  75:external/printf/printf.c **** #ifndef PRINTF_DEFAULT_FLOAT_PRECISION
  76:external/printf/printf.c **** #define PRINTF_DEFAULT_FLOAT_PRECISION  6U
  77:external/printf/printf.c **** #endif
  78:external/printf/printf.c **** 
  79:external/printf/printf.c **** // define the largest float suitable to print with %f
  80:external/printf/printf.c **** // default: 1e9
  81:external/printf/printf.c **** #ifndef PRINTF_MAX_FLOAT
  82:external/printf/printf.c **** #define PRINTF_MAX_FLOAT  1e9
  83:external/printf/printf.c **** #endif
  84:external/printf/printf.c **** 
  85:external/printf/printf.c **** // support for the long long types (%llu or %p)
  86:external/printf/printf.c **** // default: activated
  87:external/printf/printf.c **** #ifndef PRINTF_DISABLE_SUPPORT_LONG_LONG
ARM GAS  C:\Users\bernd\AppData\Local\Temp\ccLnovA9.s 			page 3


  88:external/printf/printf.c **** #define PRINTF_SUPPORT_LONG_LONG
  89:external/printf/printf.c **** #endif
  90:external/printf/printf.c **** 
  91:external/printf/printf.c **** // support for the ptrdiff_t type (%t)
  92:external/printf/printf.c **** // ptrdiff_t is normally defined in <stddef.h> as long or long long type
  93:external/printf/printf.c **** // default: activated
  94:external/printf/printf.c **** #ifndef PRINTF_DISABLE_SUPPORT_PTRDIFF_T
  95:external/printf/printf.c **** #define PRINTF_SUPPORT_PTRDIFF_T
  96:external/printf/printf.c **** #endif
