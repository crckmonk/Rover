 503:external/printf/printf.c ****   conv.U = (conv.U & ((1ULL << 52U) - 1U)) | (1023ULL << 52U);  // drop the exponent so conv.F is n
 504:external/printf/printf.c ****   // now approximate log10 from the log2 integer part and an expansion of ln around 1.5
 505:external/printf/printf.c ****   int expval = (int)(0.1760912590558 + exp2 * 0.301029995663981 + (conv.F - 1.5) * 0.28952965460216
