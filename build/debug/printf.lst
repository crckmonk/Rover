 178:external/printf/printf.c **** // internal secure strlen
 179:external/printf/printf.c **** // \return The length of the string (excluding the terminating 0) limited by 'maxsize'
 180:external/printf/printf.c **** static inline unsigned int _strnlen_s(const char* str, size_t maxsize)
 181:external/printf/printf.c **** {
 182:external/printf/printf.c ****   const char* s;
 183:external/printf/printf.c ****   for (s = str; *s && maxsize--; ++s);
 184:external/printf/printf.c ****   return (unsigned int)(s - str);
 185:external/printf/printf.c **** }
 186:external/printf/printf.c **** 
 187:external/printf/printf.c **** 
 188:external/printf/printf.c **** // internal test if char is a digit (0-9)
 189:external/printf/printf.c **** // \return true if char is a digit
 190:external/printf/printf.c **** static inline bool _is_digit(char ch)
 191:external/printf/printf.c **** {
 192:external/printf/printf.c ****   return (ch >= '0') && (ch <= '9');
 193:external/printf/printf.c **** }
 194:external/printf/printf.c **** 
