  37:external/printf/printf.c **** 
  38:external/printf/printf.c **** 
  39:external/printf/printf.c **** // define this globally (e.g. gcc -DPRINTF_INCLUDE_CONFIG_H ...) to include the
  40:external/printf/printf.c **** // printf_config.h header file
  41:external/printf/printf.c **** // default: undefined
  42:external/printf/printf.c **** #ifdef PRINTF_INCLUDE_CONFIG_H
